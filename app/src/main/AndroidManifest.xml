<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Requested at runtime, only when the "next event" widget is switched on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- One alarm per focus session, to make a noise at the end. USE_EXACT_ALARM is
         install-granted for timer apps on 33+; SCHEDULE_EXACT_ALARM covers 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="minimx"
        android:supportsRtl="true"
        android:theme="@style/Theme.Minimx">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <!--
              LAUNCHER is here so the app is reachable from another launcher before it is
              the default home, and so tooling that resolves a "default activity" (Android
              Studio's Run button) finds one. Apps.load() drops our own package, so minimx
              still never appears in its own list.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".FocusEndReceiver"
            android:exported="false" />
    </application>
</manifest>
